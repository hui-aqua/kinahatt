FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      p;
}

dimensions      [0 2 -2 0 0 0 0];

internalField   uniform 0;

boundaryField
{
    inlet
    {
        type            zeroGradient;
    }

    outside
    {
        type            fixedValue;
        value           uniform 0;
    }

    pipeWall
    {
        type            zeroGradient;
    }

    hatt
    {
        type            zeroGradient;
    }
}
