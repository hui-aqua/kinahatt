FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      nut;
}

dimensions      [0 2 -1 0 0 0 0];

internalField   uniform 0;

boundaryField
{
    inlet
    {
        type            calculated;
        value           uniform 0;
    }

    outside
    {
        type            calculated;
        value           uniform 0;
    }

    pipeWall
    {
        type            nutkWallFunction;
        value           uniform 0;
    }

    hatt
    {
        type            nutkWallFunction;
        value           uniform 0;
    }
}
